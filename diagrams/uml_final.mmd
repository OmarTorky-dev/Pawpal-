classDiagram
    %% PawPal+ final UML: matches pawpal_system.py
    %% generate_plan returns (planned, skipped). Task.time is normalized "HH:MM";
    %% priority is low|medium|high; frequency is once|daily|weekly.

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Optional~Pet~
        +get_all_tasks() list~Task~
    }

    class Pet {
        <<dataclass>>
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(description: str) bool
        +get_tasks() list~Task~
    }

    class Task {
        <<dataclass>>
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +datetime start
        +datetime end
        +__post_init__() None
        +mark_complete() None
        +next_occurrence(completed_on: date) Optional~Task~
    }

    class Scheduler {
        +Owner owner
        +get_todays_tasks(today: date) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed, tasks) list~Task~
        +detect_conflicts(tasks) list~str~
        +mark_task_complete(pet_name, description, today) Optional~Task~
        +generate_plan(today) tuple
        +explain_plan(planned, skipped) list~str~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : reads pets and tasks via
    Scheduler ..> Task : sorts, filters, plans
    Task ..> Task : next_occurrence() creates
