classDiagram
    %% PawPal+ draft UML (Phase 1). The final version lives in diagrams/uml_final.mmd.

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(description: str) bool
        +get_tasks() list~Task~
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +mark_complete() None
        +next_occurrence() Task
    }

    class Scheduler {
        +Owner owner
        +get_todays_tasks() list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +detect_conflicts(tasks) list~str~
        +mark_task_complete(pet_name, description) Task
        +generate_plan() list~Task~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : reads pets/tasks from
